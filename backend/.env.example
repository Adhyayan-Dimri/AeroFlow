# MongoDB Configuration
# Option 1: Local MongoDB (install from https://www.mongodb.com/try/download/community)
MONGO_URL=mongodb://localhost:27017
# Option 2: MongoDB Atlas (cloud) - replace with your connection string
# MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/aeroflow?retryWrites=true&w=majority
DB_NAME=aeroflow

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Email Configuration (Resend)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=AeroFlow

# Gmail SMTP Configuration (Alternative to Resend)
# Enable this to use Gmail instead of Resend
# To get an App Password: https://support.google.com/accounts/answer/185833
GMAIL_ENABLED=false
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# OpenStreetMap + OSRM Configuration (Free, no API key required)
# Uses public OSRM server and Nominatim for geocoding
# Airport coordinates are hardcoded for Indira Gandhi International Airport, Terminal 3

# Twilio Configuration (SMS - currently mocked)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=your_phone_number

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

# Automated tests only — when set, registration uses this fixed OTP instead of a random one.
# Do NOT set in production.
# TEST_OTP=424242
